{
  "name": "my-saga",
  "productName": "my saga",
  "version": "1.0.0",
  "description": "A private, local-first diary.",
  "main": "main.js",
  "scripts": {
    "start": "node copy-web.js && electron .",
    "dist": "node copy-web.js && electron-builder --win"
  },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.mysaga.app",
    "files": ["main.js", "web/**"],
    "win": { "target": ["nsis", "portable"], "icon": "web/icons/icon-512.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
